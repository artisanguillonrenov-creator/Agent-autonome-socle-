# Copiez ce fichier en .env et remplissez uniquement ce que vous utilisez.
# Tout ce qui reste vide désactive simplement la fonctionnalité cloud
# correspondante: Jarvis reste fonctionnel en mode 100% offline sans rien
# renseigner ici.

# --- Fallback cloud (désactivé par défaut, priorité au offline) ---
JARVIS_ALLOW_CLOUD_FALLBACK=false
OPENAI_API_KEY=
GROQ_API_KEY=
PORCUPINE_ACCESS_KEY=

# --- Mémoire ---
JARVIS_CHROMA_DIR=./data/chroma
JARVIS_SUMMARY_DAYS=7

# --- Voix ---
JARVIS_WAKE_WORD=jarvis
VOSK_MODEL_PATH=
JARVIS_WHISPER_MODEL=base
JARVIS_TTS_RATE=180
JARVIS_LANGUAGE=fr
JARVIS_PUSH_TO_TALK_ONLY=true

# --- Outils ---
JARVIS_SANDBOX_DIR=./sandbox

# --- Divers ---
JARVIS_LOG_LEVEL=INFO
