# --- Fournisseur LLM (Brique 1/6/orchestration) ---
# "anthropic" | "openai" | "ollama" | "mock"
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Fournisseur d'embeddings (Brique 2 : mémoire vectorielle) ---
# "local" (zéro dépendance, feature hashing) | "openai" | "voyage"
EMBEDDING_PROVIDER=local

VOYAGE_API_KEY=

# --- Recherche web (skill web_search) ---
# "brave" | "none" (aucune recherche web tant que non configuré)
WEB_SEARCH_PROVIDER=none
BRAVE_SEARCH_API_KEY=

# --- Exécution de code (skill execute_code) — désactivée par défaut, capacité sensible ---
ENABLE_CODE_EXECUTION=false
CODE_EXECUTION_TIMEOUT_MS=5000

# --- Façade(s) actives (Brique 8) ---
# "cli" | "http" | "cli,http" (les deux en même temps, même Agent)
AGENT_INTERFACE=cli
API_PORT=3000
# Si vide : API non protégée (ne pas exposer au-delà de localhost dans ce cas)
API_TOKEN=

# --- Persistance (Brique 9) ---
AGENT_DB_PATH=./data/agent.db

# --- Boucle agent (Brique 1) ---
AGENT_MAX_ITERATIONS=5

# --- Réflexion périodique (Brique 3) ---
REFLECTION_EVERY_N_STEPS=8

# --- Budget de contexte (Brique 7), estimation grossière : ~4 caractères = 1 token ---
CONTEXT_TOKEN_BUDGET=4000
