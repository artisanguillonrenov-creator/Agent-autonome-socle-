# --- Fournisseur LLM (Brique 1/6/orchestration) ---
# "anthropic" | "openai" | "openrouter" | "ollama" | "infermatic" | "mock"
LLM_PROVIDER=infermatic
# Modèle nominal par défaut de Jarvis sur Infermatic.
LLM_MODEL=Qwen-Qwen3.6-35B-A3B

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Priorité modèle local Jarvis (Chantier 10) ---
# "local" signifie local par rapport au runtime backend de l'Agent, jamais implicitement
# un modèle Android embarqué. V1 supporte Ollama comme candidat local.
LOCAL_LLM_PROVIDER=ollama
# Vide = aucun candidat local configuré ; Jarvis reste alors sur son provider nominal.
LOCAL_LLM_MODEL=
# 0/absent = tenter de lire la fenêtre réelle via Ollama /api/show.
LOCAL_LLM_CONTEXT_WINDOW=
LOCAL_LLM_PROBE_TTL_MS=60000

# --- Infermatic (Core API OpenAI-compatible, https://api.totalgpt.ai/v1) ---
# La clé API de l'abonnement Infermatic est requise pour le provider nominal ci-dessus.
# Le catalogue de modèles reste récupéré dynamiquement via GET /models.
INFERMATIC_API_KEY=
INFERMATIC_BASE_URL=https://api.totalgpt.ai/v1

# --- Software Factory : provider/modèle indépendants du LLM principal de Jarvis ---
# La Software Factory réutilise INFERMATIC_API_KEY / INFERMATIC_BASE_URL ci-dessus,
# via l'abstraction de providers LLM existante (createLLMProvider). Elle n'utilise
# jamais le provider actif de Jarvis ni la sélection persistée du panneau "Modèles IA".
SOFTWARE_FACTORY_PROVIDER=infermatic
SOFTWARE_FACTORY_MODEL=Qwen-Qwen3.6-35B-A3B
# Budget de sortie du LLM pour générer un fichier complet (Infermatic documente
# max_tokens sur /chat/completions et utilise 7000 dans son exemple officiel).
SOFTWARE_FACTORY_MAX_TOKENS=7000

# --- Fournisseur d'embeddings (Brique 2 : mémoire vectorielle) ---
# "local" (zéro dépendance, feature hashing) | "openai" | "voyage"
EMBEDDING_PROVIDER=local

VOYAGE_API_KEY=

# --- Recherche web (skill web_search) ---
# "tavily" (recommandé pour IA, clé d'API Tavily) | "serper" (Google Search API) |
# "brave" (API Brave Search) | "duckduckgo" (gratuit, sans clé) | "none"
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=

# --- Exécution de code (skill execute_code) — désactivée par défaut, capacité sensible ---
ENABLE_CODE_EXECUTION=false
CODE_EXECUTION_TIMEOUT_MS=5000

# --- Façade(s) actives (Brique 8) ---
# "cli" | "http" | "cli,http" (les deux en même temps, même Agent)
AGENT_INTERFACE=cli
API_PORT=3000
# Obligatoire dès que AGENT_INTERFACE inclut "http" sur un déploiement hébergé (PORT défini
# par la plateforme, ex. Render) : le serveur refuse de démarrer sans lui dans ce cas. Peut
# rester vide uniquement pour un usage strictement local (PORT non défini).
API_TOKEN=

# --- Persistance (Brique 9) ---
AGENT_DB_PATH=./data/agent.db

# --- Boucle agent (Brique 1) ---
AGENT_MAX_ITERATIONS=5

# --- Réflexion périodique (Brique 3) ---
REFLECTION_EVERY_N_STEPS=8

# --- Budget de contexte (Brique 7), estimation grossière : ~4 caractères = 1 token ---
CONTEXT_TOKEN_BUDGET=4000

# --- Voix / idempotence ingress (Chantier 10) ---
# Ne purge que les commandes DONE. RUNNING/RECOVERY_REQUIRED ne sont jamais purgées automatiquement.
VOICE_INGRESS_TTL_MS=604800000
VOICE_SUMMARY_THRESHOLD_CHARS=400

# --- Alertes SMS (Chantier 10) ---
# Provider-agnostic : POST JSON {to,text}; aucune permission Android SEND_SMS.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
ALERT_SMS_TO=

# Agentic bounded concurrency (hard maximum: 8)
PLAN_MAX_PARALLEL=3
BACKGROUND_MAX_CONCURRENT=3

# --- Model Context Protocol (MCP) : serveurs d'outils externes (stdio/SSE) ---
MCP_ENABLED=false
MCP_SERVERS_PATH=./config/mcp-servers.json
MCP_CONNECT_TIMEOUT_MS=10000
MCP_REQUEST_TIMEOUT_MS=60000

# --- Tracing/observabilité Langfuse (optionnel, best-effort) ---
# Vide = aucun appel réseau n'est jamais effectué ; le Tracer local (src/observability/tracer.ts) reste actif seul.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_FLUSH_INTERVAL_MS=3000
LANGFUSE_MAX_BATCH_SIZE=20

# --- Sandboxing sécurisé (Software Factory / execute_code) ---
# Par défaut : conteneur Docker éphémère, sans réseau, sans montage du système hôte ni du .env.
SANDBOX_DOCKER_ENABLED=true
SANDBOX_DOCKER_IMAGE=node:22-slim
SANDBOX_DOCKER_MEMORY_MB=256
SANDBOX_DOCKER_NANO_CPUS=1000000000
SANDBOX_DOCKER_NETWORK_ENABLED=false
# Si fourni, remplace Docker par la sandbox managée E2B (aucune installation Docker requise).
E2B_API_KEY=
E2B_TIMEOUT_MS=30000
# Software Factory : commande de validation optionnelle exécutée en sandbox isolée avant commit (vide = désactivé).
SOFTWARE_FACTORY_SANDBOX_VALIDATION_COMMAND=
SOFTWARE_FACTORY_SANDBOX_TIMEOUT_MS=60000
