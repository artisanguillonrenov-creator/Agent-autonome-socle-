# --- Fournisseur LLM (Brique 1/6/orchestration) ---
# "anthropic" | "openai" | "ollama" | "mock"
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Fournisseur d'embeddings (Brique 2 : mémoire vectorielle) ---
# "local" (zéro dépendance, feature hashing) | "openai" | "voyage"
EMBEDDING_PROVIDER=local

VOYAGE_API_KEY=

# --- Persistance (Brique 9) ---
AGENT_DB_PATH=./data/agent.db

# --- Boucle agent (Brique 1) ---
AGENT_MAX_ITERATIONS=5

# --- Réflexion périodique (Brique 3) ---
REFLECTION_EVERY_N_STEPS=8

# --- Budget de contexte (Brique 7), estimation grossière : ~4 caractères = 1 token ---
CONTEXT_TOKEN_BUDGET=4000
