{
  "name": "agent-autonome-socle",
  "version": "0.1.0",
  "description": "Socle générique pour agent IA autonome — boucle agent, mémoire multi-niveaux, réflexion, planification hiérarchique, bibliothèque de compétences, orchestration de rôles, budget de contexte, façade CLI, persistance locale.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "agent": "dist/index.js"
  },
  "scripts": {
    "postinstall": "patch-package",
    "build": "tsc -p tsconfig.json && node scripts/build-ota.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import ./scripts/test-env.mjs --import tsx --test --test-concurrency=1 --test-force-exit \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@octokit/rest": "^22.0.1",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "unzipper": "^0.10.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.20.2",
    "@types/unzipper": "^0.10.11",
    "patch-package": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
