# Vague 10D : variables d'environnement pour l'exécution via docker-compose.yml.
# Copier ce fichier vers `.env` à la racine du projet (utilisé par `env_file: .env` dans
# docker-compose.yml) et renseigner les secrets réels avant `docker compose up`.
# Les noms d'hôte ci-dessous sont ceux des SERVICES internes définis dans docker-compose.yml
# (résolution DNS interne Docker), jamais localhost/127.0.0.1 entre conteneurs.

# ---------------------------------------------------------------------------
# Base de données — PostgreSQL managé par le service jarvis-db (remplace SQLite en
# production). Laisser vide en développement local hors Docker pour retomber sur SQLite
# (AGENT_DB_PATH ci-dessous).
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://jarvis:changeme@jarvis-db:5432/jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jarvis
AGENT_DB_PATH=./data/agent.db

# ---------------------------------------------------------------------------
# Serveur HTTP / API
# ---------------------------------------------------------------------------
PORT=3000
API_TOKEN=changeme-generate-a-strong-random-token
AGENT_INTERFACE=http

# ---------------------------------------------------------------------------
# Fournisseur LLM nominal (brique 1)
# ---------------------------------------------------------------------------
LLM_PROVIDER=infermatic
LLM_MODEL=Qwen-Qwen3.6-35B-A3B
INFERMATIC_API_KEY=
INFERMATIC_BASE_URL=https://api.totalgpt.ai/v1
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
LLM_REASONING_MODEL=
LLM_FAST_MODEL=

# ---------------------------------------------------------------------------
# Vague 8A : disjoncteur financier — actif par défaut, seuil horaire en USD.
# ---------------------------------------------------------------------------
FINANCIAL_CIRCUIT_BREAKER_ENABLED=true
FINANCIAL_CIRCUIT_BREAKER_HOURLY_LIMIT_USD=2.00
FINANCIAL_CIRCUIT_BREAKER_WINDOW_MS=3600000

# ---------------------------------------------------------------------------
# Vague 8B : vision multi-modale
# ---------------------------------------------------------------------------
VISION_ENABLED=true
VISION_MODEL=
VISION_SCREENSHOT_TIMEOUT_MS=20000
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ---------------------------------------------------------------------------
# Vague 8C : apprentissage par renforcement local (évolution dynamique du prompt)
# ---------------------------------------------------------------------------
PROMPT_EVOLUTION_ENABLED=false
DYNAMIC_RULES_PATH=./config/dynamic_rules.json
PROMPT_EVOLUTION_MAX_RULES=200

# ---------------------------------------------------------------------------
# Vague 9 : streaming audio bidirectionnel (WebSocket), STT/TTS, sync Android
# ---------------------------------------------------------------------------
AUDIO_STREAMING_ENABLED=false
AUDIO_STREAMING_WS_PATH=/api/voice/stream
AUDIO_SESSION_GRACE_MS=30000
AUDIO_VAD_SILENCE_MS=500
AUDIO_VAD_ENERGY_THRESHOLD=500
STT_WEBHOOK_URL=
STT_WEBHOOK_TOKEN=
TTS_WEBHOOK_URL=
TTS_WEBHOOK_TOKEN=
ANDROID_FCM_WEBHOOK_URL=
ANDROID_FCM_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Alertes (email/SMS) — jamais simulées : un canal non configuré échoue explicitement.
# ---------------------------------------------------------------------------
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
ALERT_EMAIL_TO=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
ALERT_SMS_TO=

# ---------------------------------------------------------------------------
# Observabilité Langfuse (optionnel)
# ---------------------------------------------------------------------------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Sandboxing sécurisé (Vague 10C) — Docker-in-Docker via socket monté (voir docker-compose.yml)
# ---------------------------------------------------------------------------
SANDBOX_DOCKER_ENABLED=true
SANDBOX_DOCKER_IMAGE=node:22-slim
SANDBOX_DOCKER_MEMORY_MB=256
SANDBOX_DOCKER_NANO_CPUS=1000000000
SANDBOX_DOCKER_NETWORK_ENABLED=false
SANDBOX_WORKDIR=/tmp/jarvis-sandbox
ENABLE_CODE_EXECUTION=false
E2B_API_KEY=

# ---------------------------------------------------------------------------
# Recherche Web / embeddings (optionnel)
# ---------------------------------------------------------------------------
WEB_SEARCH_PROVIDER=duckduckgo
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# MCP (Model Context Protocol) — serveurs tiers, voir service mcp-server-bridge
# ---------------------------------------------------------------------------
MCP_ENABLED=false
MCP_SERVERS_PATH=./config/mcp-servers.json

# ---------------------------------------------------------------------------
# Callback HMAC (workers/n8n asynchrones)
# ---------------------------------------------------------------------------
JARVIS_CALLBACK_HMAC_SECRET=

# ---------------------------------------------------------------------------
# Réarmement admin / hébergement éphémère
# ---------------------------------------------------------------------------
HEARTBEAT_SELF_URL=
GUARDRAIL_ENABLED=false
